<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.soporte_tecnico.controller.ClienteController">
    <content>
        <VBox spacing="18.0">
            <padding><Insets bottom="32.0" left="42.0" right="42.0" top="32.0" /></padding>
            <Label text="Registro de clientes">
                <font>
                    <Font name="System Bold" size="24.0" />
                </font></Label>
            <Separator />
            <GridPane hgap="16.0" vgap="15.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="190.0" prefWidth="210.0" />
                    <ColumnConstraints hgrow="ALWAYS" minWidth="300.0" />
                    <ColumnConstraints minWidth="105.0" />
                </columnConstraints>
                <Label text="Nombre completo" GridPane.rowIndex="0" />
                <TextField fx:id="nombreField" promptText="Nombre del cliente" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0" />
                <Label text="Correo" GridPane.rowIndex="1" />
                <TextField fx:id="correoField" promptText="Ingrese el correo" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                <Label text="Telefono" GridPane.rowIndex="2" />
                <TextField fx:id="telefonoField" promptText="Ej. +505 8888 8888" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                <Label text="Tipo de cliente" GridPane.rowIndex="3" />
                <ComboBox fx:id="tipoClienteCombo" maxWidth="Infinity" promptText="Seleccione una opción" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />
                <Label text="Documento" wrapText="true" GridPane.rowIndex="4" />
                <TextField fx:id="documentoField" editable="false" promptText="Ningún archivo seleccionado" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <Button onAction="#seleccionarDocumento" text="Seleccionar Documento " GridPane.columnIndex="2" GridPane.rowIndex="4" />
                <Label text="Directorio del cliente " GridPane.rowIndex="5" />
                <TextField fx:id="directorioField" editable="false" promptText="Ninguna carpeta seleccionada" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                <Button onAction="#seleccionarDirectorio" text="Seleccionar..." GridPane.columnIndex="2" GridPane.rowIndex="5" />
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>
            <Label text="* Campos obligatorios" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button onAction="#guardar" prefWidth="105.0" text="Guardar" />
                <Button onAction="#crearSolicitud" prefWidth="135.0" text="Crear solicitud" />
                <Button onAction="#limpiar" prefWidth="105.0" text="Limpiar" />
                <Button fx:id="btnMenuPrincipal" onAction="#abrirMenu" prefWidth="105.0" text="Menu princiapl" />
            </HBox>
        </VBox>
    </content>
</ScrollPane>
